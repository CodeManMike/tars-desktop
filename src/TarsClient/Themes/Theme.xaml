<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:TarsClient.Controls">

    <!-- ============================================================ palette (spec section 3) -->
    <Color x:Key="BgColor">#000000</Color>
    <Color x:Key="FgColor">#FF8800</Color>
    <Color x:Key="FgBrightColor">#FFB347</Color>
    <Color x:Key="FgDimColor">#7A4000</Color>
    <Color x:Key="SelColor">#2A1500</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Fg" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="FgBright" Color="{StaticResource FgBrightColor}" />
    <SolidColorBrush x:Key="FgDim" Color="{StaticResource FgDimColor}" />
    <SolidColorBrush x:Key="Sel" Color="{StaticResource SelColor}" />

    <!-- VT323 has no block/box glyphs: Consolas supplies █ ░ ▌ ■ ═ ← → ▲ ► -->
    <FontFamily x:Key="TermFont">pack://application:,,,/Assets/#VT323, Consolas</FontFamily>

    <DropShadowEffect x:Key="Glow" Color="{StaticResource FgColor}" BlurRadius="7" ShadowDepth="0" Opacity="0.5" RenderingBias="Performance" />

    <!-- 1 px black lines at 35 % every 3 px, tiled -->
    <DrawingBrush x:Key="ScanlineBrush" TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute" Viewbox="0,0,3,3" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000" Geometry="M0,0 H3 V3 H0 Z" />
                <GeometryDrawing Brush="#59000000" Geometry="M0,2 H3 V3 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ============================================================ base text -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased" />
    </Style>

    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{StaticResource FgDim}" StrokeThickness="1" StrokeDashArray="1 2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ [BUTTON] -->
    <Style x:Key="RetroButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="1,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <TextBlock x:Name="Tx" Foreground="{TemplateBinding Foreground}">
                            <Run Text="[" /><Run Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" /><Run Text="]" />
                        </TextBlock>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Fg}" />
                            <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Bg}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sel}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FgBright}" />
                            <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Bg}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Fg}" />
                            <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Bg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource FgDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource RetroButton}" />
    <Style TargetType="ToggleButton" BasedOn="{StaticResource RetroButton}" />

    <!-- A plain clickable text item (timers): hover inverts, no brackets -->
    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Fg}" />
                            <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Bg}" />
                            <Setter TargetName="Tx" Property="TextDecorations" Value="Strikethrough" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sel}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ [X] CHECK -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" Background="Transparent" Padding="0,1">
                        <TextBlock>
                            <Run x:Name="Box" Text="[ ] " /><Run Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Text" Value="[X] " />
                            <Setter TargetName="Box" Property="Foreground" Value="{StaticResource FgBright}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sel}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sel}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ text entry -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource FgBright}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Fg}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A boxed field: "____" underline look for settings rows -->
    <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="BorderBrush" Value="{StaticResource FgDim}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Background" Value="{StaticResource Sel}" />
        <Setter Property="Padding" Value="2,0" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource FgBright}" />
        <Setter Property="Background" Value="{StaticResource Sel}" />
        <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
        <Setter Property="BorderBrush" Value="{StaticResource FgDim}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="PasswordChar" Value="•" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="2,0">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ scrollbars: 5 px orange rails -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="5" />
        <Setter Property="MinWidth" Value="5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Rectangle Fill="{StaticResource FgDim}" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="5" />
                <Setter Property="MinHeight" Value="5" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Rectangle Fill="{StaticResource FgDim}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ list (FILES) -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="2,0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sel}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Fg}" />
                            <Setter Property="TextElement.Foreground" Value="{StaticResource Bg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ retro controls -->
    <Style TargetType="c:BlockSlider">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:BlockSlider">
                    <Border x:Name="Bd" Background="Transparent" Padding="0,1">
                        <TextBlock x:Name="PART_Text" Text="{TemplateBinding Text}" HorizontalAlignment="Left" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sel}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sel}" />
                            <Setter TargetName="PART_Text" Property="Foreground" Value="{StaticResource FgBright}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:ChoiceRow">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ChoiceRow">
                    <Border x:Name="Bd" Background="Transparent" Padding="0,1">
                        <TextBlock x:Name="Tx" Text="{TemplateBinding Text}" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sel}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sel}" />
                            <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource FgBright}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tabs: [PERSONALITY] [VOICE] … selected one inverted -->
    <Style x:Key="TabItemStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" Padding="1,0">
                        <TextBlock x:Name="Tx">
                            <Run Text="[" /><Run Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" /><Run Text="]" />
                        </TextBlock>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sel}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Fg}" />
                            <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Bg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ tray menu -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Fg}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource TermFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="2">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" Padding="6,1,12,1">
                            <DockPanel>
                                <TextBlock x:Name="Check" DockPanel.Dock="Left" Text="  " Width="18" />
                                <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Text=" ▸" Visibility="Collapsed" />
                                <TextBlock x:Name="Tx" Text="{TemplateBinding Header}" />
                            </DockPanel>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="False" Focusable="False">
                            <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Fg}" BorderThickness="1" Padding="2">
                                <StackPanel IsItemsHost="True" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Text" Value="✓" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Fg}" />
                            <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Bg}" />
                            <Setter TargetName="Check" Property="Foreground" Value="{StaticResource Bg}" />
                            <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource Bg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{StaticResource FgDim}" Margin="4,3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Fg}" />
        <Setter Property="FontFamily" Value="{StaticResource TermFont}" />
        <Setter Property="FontSize" Value="16" />
    </Style>
</ResourceDictionary>
