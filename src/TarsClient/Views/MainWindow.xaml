<Window x:Class="TarsClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:TarsClient.Controls"
        xmlns:vm="clr-namespace:TarsClient.ViewModels"
        Title="TARS"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource TermFont}" FontSize="18"
        MinWidth="260" MinHeight="110" Width="380" Height="150"
        Topmost="{Binding Topmost}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <c:BoolToVis x:Key="Vis" />
        <c:BoolToVis x:Key="NotVis" Invert="True" />
        <c:IndexToVis x:Key="TabVis" />
        <c:IndexToBool x:Key="TabBool" />
        <c:LineBrush x:Key="LineBrush" />
        <c:TagFormat x:Key="Tag" />
        <c:FlashBrush x:Key="Flash" />
        <c:Scale x:Key="Scale" />

        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgDim}" />
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgBright}" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>

        <!-- a focusable row for the SERVER screen -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sel}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sel}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- timers: RICE 11:42 · PASTA 04:03 · 15:00 call mom -->
        <DataTemplate x:Key="TimerTemplate" DataType="{x:Type vm:TimerItem}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Sep" Text=" · " Style="{StaticResource Dim}" />
                <Button Style="{StaticResource TextButton}" Content="{Binding Display}" ToolTip="Click (or Del) to cancel"
                        Command="{Binding DataContext.CancelTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Id}" PreviewKeyDown="Timer_PreviewKeyDown" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter TargetName="Sep" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Frame" BorderThickness="1"
            BorderBrush="{Binding FlashOn, Converter={StaticResource Flash}, ConverterParameter=Fg}">
        <Grid>
            <!-- ======================================================== everything that glows -->
            <Grid x:Name="Screen" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="PowerOn" ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ==================================================== title bar -->
                <DockPanel Grid.Row="0" Margin="6,0,2,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Content="PIN" IsChecked="{Binding Topmost}" ToolTip="Pin: keep TARS above other windows" Focusable="False"
                                      WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="▭" Click="Layout_Click" ToolTip="Switch compact / expanded terminal (or double-click the title bar)" Focusable="False"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="_" Click="Minimize_Click" ToolTip="Minimize to the taskbar" Focusable="False"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="×" Click="Hide_Click" ToolTip="Hide to the tray (TARS keeps listening; Quit is in the tray menu)" Focusable="False"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="■" Foreground="{Binding FlashOn, Converter={StaticResource Flash}, ConverterParameter=Fg}" />
                        <Run Text="{Binding AssistantName, Mode=OneWay}" />
                        <Run Text=" " /><Run Text="{Binding StatusTag, Mode=OneWay, Converter={StaticResource Tag}}" Foreground="{StaticResource FgBright}" />
                        <Run Text=" " /><Run Text="{Binding VoiceTag, Mode=OneWay}" Foreground="{StaticResource FgDim}" />
                    </TextBlock>
                </DockPanel>

                <!-- ==================================================== body -->
                <Grid Grid.Row="1" Margin="6,0,6,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ~~~ compact -->
                    <Grid Grid.Row="0" Visibility="{Binding IsExpanded, Converter={StaticResource NotVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding LastUtterance}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding PromptActive, Converter={StaticResource NotVis}}" />
                        <DockPanel Visibility="{Binding PromptActive, Converter={StaticResource Vis}}">
                            <TextBlock Text="&gt; " />
                            <TextBox x:Name="CompactPrompt" Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}"
                                     c:BlockCaret.Enabled="True" PreviewKeyDown="Prompt_PreviewKeyDown" />
                        </DockPanel>
                        <ScrollViewer x:Name="ReplyScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgBright}">
                                <Run Text="{Binding ReplyText, Mode=OneWay}" /><Run x:Name="ReplyCursor" Foreground="{DynamicResource CursorBrush}">
                                    <Run.Style>
                                        <Style TargetType="Run">
                                            <Setter Property="Text" Value="" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CursorVisible}" Value="True">
                                                    <Setter Property="Text" Value="▌" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Run.Style>
                                </Run>
                            </TextBlock>
                        </ScrollViewer>
                    </Grid>

                    <!-- ~~~ expanded: scrollback -->
                    <ScrollViewer x:Name="Scrollback" Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,2,0,2">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsExpanded}" Value="True" />
                                            <Condition Binding="{Binding SettingsOpen}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <TextBlock x:Name="Banner" Foreground="{StaticResource FgBright}" Margin="0,4,0,10" ToolTip="T.A.R.S"
                                       LineStackingStrategy="BlockLineHeight" LineHeight="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource Scale}, ConverterParameter=0.78}" />
                            <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TermLine}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{Binding Kind, Converter={StaticResource LineBrush}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- the prompt follows the last line, like a real terminal -->
                            <DockPanel Margin="0,2,0,0" ToolTip="Type to TARS · Enter sends · Esc clears">
                                <TextBlock Text="&gt; " />
                                <TextBox x:Name="ExpandedPrompt" Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}"
                                         c:BlockCaret.Enabled="True" PreviewKeyDown="Prompt_PreviewKeyDown" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ~~~ expanded: settings -->
                    <Grid Grid.Row="0" DataContext="{Binding Settings}" Margin="0,2,0,2"
                          Visibility="{Binding DataContext.SettingsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}"
                          PreviewKeyDown="Settings_PreviewKeyDown">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <WrapPanel x:Name="TabStrip" Grid.Row="0" KeyboardNavigation.DirectionalNavigation="Cycle">
                            <RadioButton Style="{StaticResource TabItemStyle}" GroupName="tabs" Content="PERSONALITY" IsChecked="{Binding TabIndex, Converter={StaticResource TabBool}, ConverterParameter=0}" />
                            <RadioButton Style="{StaticResource TabItemStyle}" GroupName="tabs" Content="VOICE" IsChecked="{Binding TabIndex, Converter={StaticResource TabBool}, ConverterParameter=1}" />
                            <RadioButton Style="{StaticResource TabItemStyle}" GroupName="tabs" Content="AUDIO" IsChecked="{Binding TabIndex, Converter={StaticResource TabBool}, ConverterParameter=2}" />
                            <RadioButton Style="{StaticResource TabItemStyle}" GroupName="tabs" Content="SYSTEM" IsChecked="{Binding TabIndex, Converter={StaticResource TabBool}, ConverterParameter=3}" />
                            <RadioButton Style="{StaticResource TabItemStyle}" GroupName="tabs" Content="SERVER" IsChecked="{Binding TabIndex, Converter={StaticResource TabBool}, ConverterParameter=4}" />
                            <RadioButton Style="{StaticResource TabItemStyle}" GroupName="tabs" Content="FILES" IsChecked="{Binding TabIndex, Converter={StaticResource TabBool}, ConverterParameter=5}" />
                            <RadioButton Style="{StaticResource TabItemStyle}" GroupName="tabs" Content="STATUS" IsChecked="{Binding TabIndex, Converter={StaticResource TabBool}, ConverterParameter=6}" />
                        </WrapPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource Dim}" Text="════════════════════════════════════════════════════════════════════════════════════════════════════════════" TextTrimming="None" ClipToBounds="True" />

                        <!-- ============ PERSONALITY -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding TabIndex, Converter={StaticResource TabVis}, ConverterParameter=0}">
                            <StackPanel Margin="0,6,0,0">
                                <c:BlockSlider Label="HUMOR" Value="{Binding Humor}" />
                                <c:BlockSlider Label="HONESTY" Value="{Binding Honesty}" />
                                <c:BlockSlider Label="BREVITY" Value="{Binding Brevity}" />
                                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="Live on the server: every connected client sees the change. Ask &quot;what's your humor setting&quot; to check." />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ VOICE -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding TabIndex, Converter={StaticResource TabVis}, ConverterParameter=1}">
                            <StackPanel Margin="0,6,6,0">
                                <TextBlock><Run Text="SIDECAR       " /><Run Text="{Binding VoiceStatus, Mode=OneWay}" Foreground="{StaticResource FgBright}" /></TextBlock>
                                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Text="All of TARS's voice is generated on this PC. Nothing is voiced by the server." />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="INSTALL VOICE ENGINE" Command="{Binding InstallVoiceCommand}" Visibility="{Binding VoiceInstalled, Converter={StaticResource NotVis}}"
                                            ToolTip="Download and set up the local voice engine (about 4.5 GB, once)" />
                                    <Button Content="TEST VOICE" Command="{Binding TestVoiceCommand}" Margin="0,0,6,0"
                                            ToolTip="Ask the server for TARS's test line; it is voiced here, on this PC" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Head}" Text="TRY IT · type a line, tweak below, speak again" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="SPEAK" Command="{Binding SpeakPreviewCommand}"
                                            ToolTip="Voice this line with the current engine and settings (local only, nothing sent to the server)" />
                                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SpeakPreviewCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </DockPanel>

                                <TextBlock Style="{StaticResource Head}" Text="ENGINE" />
                                <c:ChoiceRow Label="MODEL" Items="{x:Static vm:SettingsViewModel.Engines}" SelectedIndex="{Binding EngineIndex}" />
                                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                                           Text="turbo: GPU, fast, natural. chatterbox: GPU, slower, honours exaggeration/pace. kokoro: CPU, light (used automatically in game mode and while the GPU model warms)." />
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="REFERENCE     " />
                                    <Button DockPanel.Dock="Right" Content="DEFAULT" Command="{Binding ResetReferenceCommand}" ToolTip="Back to the original deep voice, rendered locally" />
                                    <Button DockPanel.Dock="Right" Content="BROWSE" Command="{Binding BrowseReferenceCommand}" ToolTip="Pick a 15-20 s WAV to clone the voice from" />
                                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding ReferenceClip, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                                           Text="15–20 s WAV of calm, dry, deadpan reading: your voice or a consenting friend's. Empty = an original deep voice rendered locally. Don't use film clips of real actors." />
                                <Border BorderBrush="{StaticResource FgDim}" BorderThickness="1" Padding="6,4" Margin="0,6,0,2">
                                    <StackPanel>
                                        <TextBlock Text="RECORD A NEW TARS VOICE · TARS will sound like whoever reads this" Foreground="{StaticResource FgBright}" />
                                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                                                   Text="Use someone else's voice (a consenting friend with a deep, calm voice). To teach TARS to recognise YOUR voice, use AUDIO → TRAIN ON MY VOICE instead. Read flat and unhurried, like a status report:" />
                                        <TextBlock Text="{x:Static vm:SettingsViewModel.ReferenceScript}" TextWrapping="Wrap" Margin="0,4,0,6" />
                                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                                                   Text="Quiet room · mouth about a hand-width from the mic · low, calm voice · no smile · same pace throughout · pause briefly before the jokes." />
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Command="{Binding RecordReferenceCommand}" Margin="0,0,6,0"
                                                    ToolTip="3-2-1, then 20 seconds of recording. Saved to %APPDATA%\TARS\voices and used straight away (press again to cancel)">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Content" Value="● RECORD 20 s" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Recording}" Value="True">
                                                                <Setter Property="Content" Value="■ STOP" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="► PLAY IT" Command="{Binding PlayRecordingCommand}" ToolTip="Hear the recording (your raw voice, not TARS)" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding RecordStatus}" Foreground="{StaticResource FgBright}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Head}" Text="DELIVERY" />
                                <c:BlockSlider Label="SPEED" Value="{Binding VoiceSpeed}" Minimum="70" Maximum="130" Step="5" Cells="12"
                                               ToolTip="Speaking rate. TARS is measured: 90-100 %" />
                                <c:BlockSlider Label="TEMPERATURE" Value="{Binding Temperature}" Minimum="30" Maximum="120" Step="5" Cells="12" Unit=""
                                               ToolTip="Variation. Lower = steadier and flatter; higher = more expressive (and less predictable)" />
                                <c:BlockSlider Label="EXAGGERATION" Value="{Binding Exaggeration}"
                                               ToolTip="Emotion intensity (chatterbox engine only). 30-40 = dry and deadpan" />
                                <c:BlockSlider Label="PACE" Value="{Binding Pace}"
                                               ToolTip="Guidance / pacing (chatterbox engine only). Lower = slower, more deliberate" />
                                <TextBlock Style="{StaticResource Head}" Text="TARS FX" />
                                <CheckBox Content="ON: lower, band-limited speaker, faint metal ring" IsChecked="{Binding Fx}"
                                          ToolTip="Makes any voice sound like it comes out of a machine" />
                                <c:BlockSlider Label="FX PITCH" Value="{Binding FxPitch}" Minimum="80" Maximum="100" Step="1" Cells="10"
                                               ToolTip="100 % = unchanged. Lower = deeper and slightly slower" />
                                <c:BlockSlider Label="FX RING" Value="{Binding FxRing}" Minimum="0" Maximum="50" Step="2" Cells="10" Unit=""
                                               ToolTip="Metallic resonance. 0 = none, 20 = subtle, 40+ = robotic" />
                                <Button Content="RESET TUNING" Command="{Binding ResetVoiceTuningCommand}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                        ToolTip="Back to the default TARS delivery" />
                                <TextBlock Style="{StaticResource Head}" Text="RESOURCES" />
                                <CheckBox Content="GAME MODE: fullscreen app or &lt;3 GB VRAM → CPU voice, GPU freed" IsChecked="{Binding GameModeEnabled}"
                                          ToolTip="While a game runs, TARS speaks with the light CPU engine and frees the GPU" />
                                <c:BlockSlider Label="IDLE UNLOAD" Value="{Binding IdleUnload}" Minimum="0" Maximum="60" Step="5" Cells="12" Unit=" min"
                                               ToolTip="Free the GPU after this many quiet minutes (0 = never). The next reply reloads it" />

                                <DockPanel Margin="0,10,0,2">
                                    <Button DockPanel.Dock="Right" Content="RENDER ALL" Command="{Binding LabRenderCommand}" ToolTip="Render all 8 lines with every engine and time the first audio" />
                                    <TextBlock Style="{StaticResource Head}" Margin="0" Text="VOICE LAB · play, compare, rate by ear" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Dim}" Text="LINE         TURBO                CHATTERBOX           KOKORO" />
                                <ItemsControl ItemsSource="{Binding LabRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LabRow}">
                                            <DockPanel ToolTip="{Binding Text}">
                                                <TextBlock Text="{Binding Kind}" MinWidth="104" />
                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:LabCell}">
                                                            <StackPanel Orientation="Horizontal" MinWidth="150">
                                                                <Button Content="►" ToolTip="Play" Command="{Binding DataContext.Settings.LabPlayCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                                <TextBlock Text="{Binding Timing}" Style="{StaticResource Dim}" MinWidth="52" Margin="2,0" />
                                                                <Button Style="{StaticResource TextButton}" Content="{Binding StarText}" ToolTip="Click to rate"
                                                                        Command="{Binding DataContext.Settings.LabRateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ AUDIO -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding TabIndex, Converter={StaticResource TabVis}, ConverterParameter=2}">
                            <StackPanel Margin="0,6,0,0">
                                <c:ChoiceRow Label="INPUT" Items="{Binding Inputs}" SelectedIndex="{Binding InputIndex}" ToolTip="Microphone. Click or use left/right to cycle" />
                                <c:ChoiceRow Label="OUTPUT" Items="{Binding Outputs}" SelectedIndex="{Binding OutputIndex}" ToolTip="Speakers or headset for TARS. Click or use left/right to cycle" />
                                <c:BlockSlider Label="VOLUME" Value="{Binding DataContext.VolumePercent, RelativeSource={RelativeSource AncestorType=Window}}" Minimum="0" Maximum="150" Step="5" Cells="15" />
                                <c:BlockSlider Label="ECHO TAIL" Value="{Binding EchoTail}" Minimum="0" Maximum="1000" Step="50" Unit=" ms"
                                               ToolTip="How long the mic stays deaf after TARS stops talking, so it never hears itself" />
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="PTT KEY       " />
                                    <Button DockPanel.Dock="Right" Content="CAPTURE" Command="{Binding CapturePttCommand}" ToolTip="Press the key or mouse side button to use for push-to-talk" />
                                    <TextBlock Text="{Binding PttKey}" Foreground="{StaticResource FgBright}" />
                                </DockPanel>
                                <CheckBox Content="SWALLOW THE PTT KEY (other apps won't see it)" IsChecked="{Binding PttSwallow}" />
                                <DockPanel>
                                    <TextBlock Text="STOP HOTKEY   " />
                                    <Button DockPanel.Dock="Right" Content="CAPTURE" Command="{Binding CaptureStopCommand}" ToolTip="Press the key combination that silences TARS and dismisses alarms" />
                                    <TextBlock Text="{Binding StopHotkey}" Foreground="{StaticResource FgBright}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Head}" Text="SPEECH RECOGNITION" />
                                <TextBlock><Run Text="STT           " /><Run Text="{Binding SttStatus, Mode=OneWay}" Foreground="{StaticResource FgBright}" /></TextBlock>
                                <c:ChoiceRow Label="RECOGNITION" Items="{x:Static vm:SettingsViewModel.SttModes}" SelectedIndex="{Binding SttModeIndex}"
                                             ToolTip="LOCAL: Whisper on this PC's GPU (more accurate, nothing leaves the PC until it's text). SERVER: stream audio as before" />
                                <c:ChoiceRow Label="STT MODEL" Items="{x:Static vm:SettingsViewModel.SttModels}" SelectedIndex="{Binding SttModelIndex}"
                                             ToolTip="large-v3-turbo: best accuracy, ~1.6 GB VRAM, ~0.2-0.4 s. small.en: CPU, used automatically in game mode" />
                                <TextBlock Style="{StaticResource Head}" Text="VOICE LOCK · only you can wake TARS" />
                                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                                           Text="With YouTube or a TV on, TARS only reacts to your voice. It learns you from one 20 s reading; anything else is dropped before speech recognition runs. Push-to-talk always works." />
                                <Border BorderBrush="{StaticResource FgDim}" BorderThickness="1" Padding="6,4" Margin="0,4,0,2">
                                    <StackPanel>
                                        <TextBlock Text="READ THIS in your normal voice, the way you talk to TARS:" Foreground="{StaticResource FgBright}" />
                                        <TextBlock Text="{x:Static vm:SettingsViewModel.ReferenceScript}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Text="This only teaches TARS to recognise you. It never changes how TARS sounds. Pause any TV or music while it listens." />
                                    </StackPanel>
                                </Border>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="TRAIN ON MY VOICE" Command="{Binding TrainVoiceCommand}" Margin="0,0,6,0"
                                            ToolTip="3-2-1, then read the script on the VOICE tab (or anything) for 20 s in your normal voice. Press again to cancel" />
                                </WrapPanel>
                                <TextBlock Text="{Binding EnrollStatus}" Foreground="{StaticResource FgBright}" TextWrapping="Wrap" />
                                <CheckBox Content="VOICE LOCK ON" IsChecked="{Binding VoiceLock}"
                                          ToolTip="Hands-free (wake/open) turns must match your voiceprint" />
                                <c:BlockSlider Label="STRICTNESS" Value="{Binding SpeakerThreshold}" Minimum="50" Maximum="95" Step="1" Cells="15" Unit=""
                                               ToolTip="How close a voice must be to yours. Tested: you ~90, other voices ~60. Lower if it ignores you, raise if others get through" />
                                <CheckBox Content="MUTE MIC" IsChecked="{Binding DataContext.MicMuted, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="Hold the PTT key anywhere, even in a game. In the window, holding SPACE also talks. Mouse 4/5 work too." />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ SYSTEM -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding TabIndex, Converter={StaticResource TabVis}, ConverterParameter=3}">
                            <StackPanel Margin="0,6,6,0">
                                <DockPanel>
                                    <TextBlock Text="SERVER URL    " />
                                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding ServerUrl, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock Text="ACCESS KEY    " />
                                    <PasswordBox x:Name="KeyBox" PasswordChanged="KeyBox_PasswordChanged" />
                                </DockPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="TEST CONNECTION" Command="{Binding TestConnectionCommand}" Margin="0,0,6,0" ToolTip="Check the server's health endpoint" />
                                    <Button Content="FETCH KEY" Command="{Binding FetchKeyCommand}" Margin="0,0,6,0" ToolTip="Read the current key from the server's spec (allowlisted PCs only)" />
                                    <Button Content="RECONNECT" Command="{Binding ReconnectCommand}" ToolTip="Drop and redial the connection now" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Head}" Text="STARTUP" />
                                <CheckBox Content="START WITH WINDOWS" IsChecked="{Binding StartWithWindows}" />
                                <CheckBox Content="START MINIMIZED TO TRAY" IsChecked="{Binding StartMinimized}" />
                                <CheckBox Content="ALWAYS ON TOP" IsChecked="{Binding Topmost}" />
                                <TextBlock Style="{StaticResource Head}" Text="WINDOW" />
                                <CheckBox Content="CLICKING TARS DOESN'T STEAL KEYBOARD FOCUS" IsChecked="{Binding NoActivate}"
                                          ToolTip="Click TARS buttons without pulling focus from the app you're typing in. Clicking the prompt or settings still focuses TARS" />
                                <CheckBox Content="SHOW IN TASKBAR" IsChecked="{Binding ShowInTaskbar}" ToolTip="Off = tray only" />
                                <CheckBox Content="POP UP WHEN TARS ANSWERS (while hidden)" IsChecked="{Binding PopOnReply}" />
                                <c:BlockSlider Label="BACKGROUND" Value="{Binding BackgroundOpacity}" Minimum="20" Maximum="100" Step="5" Cells="16"
                                               ToolTip="Background opacity; text stays solid. Turning transparency on needs a restart" />
                                <WrapPanel>
                                    <Button Content="CLEAR SCROLLBACK" Command="{Binding DataContext.ClearScrollbackCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,6,0"
                                            ToolTip="Empty the terminal history" />
                                    <Button Content="RESTART TARS" Command="{Binding RestartAppCommand}" ToolTip="Restart the client (applies transparency)" Margin="0,0,6,0" />
                                    <Button Content="UNINSTALL TARS" Command="{Binding UninstallCommand}"
                                            ToolTip="Remove TARS Desktop from this PC (asks first; you choose whether to keep settings and the voice engine)" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Head}" Text="DISPLAY" />
                                <CheckBox Content="SCANLINES" IsChecked="{Binding Scanlines}" />
                                <CheckBox Content="PHOSPHOR GLOW" IsChecked="{Binding Glow}" />
                                <c:BlockSlider Label="FONT SIZE" Value="{Binding FontSize}" Minimum="14" Maximum="28" Step="1" Cells="14" Unit=" px" />
                                <c:BlockSlider Label="TYPEWRITER" Value="{Binding TypewriterCps}" Minimum="30" Maximum="300" Step="10" Cells="12" Unit=" cps" />
                                <CheckBox Content="SHOW DETAILS (timings, tools, ignored sounds)" IsChecked="{Binding ShowDetails}" />
                                <CheckBox Content="SPEAK REPLIES TO TYPED MESSAGES" IsChecked="{Binding SpeakTyped}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" Text="settings: %APPDATA%\TARS\client.json · key sealed with DPAPI" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ SERVER -->
                        <DockPanel Grid.Row="2" Visibility="{Binding TabIndex, Converter={StaticResource TabVis}, ConverterParameter=4}" Margin="0,4,0,0">
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Button Content="RELOAD" Command="{Binding LoadConfigCommand}" Margin="0,0,6,0" ToolTip="Fetch the server settings again" />
                                <Button Content="APPLY" Command="{Binding ApplyConfigCommand}" Margin="0,0,6,0" ToolTip="Save changes; fields that need it are marked PENDING RESTART" />
                                <Button Content="APPLY + RESTART" Command="{Binding ApplyRestartCommand}" Margin="0,0,6,0" ToolTip="Save and restart the server (about 10 s of NO CARRIER)" />
                                <TextBlock Text="RESTART REQUIRED" Foreground="{StaticResource FgBright}" Visibility="{Binding RestartRequired, Converter={StaticResource Vis}}" />
                            </WrapPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ConfigRows}" Margin="0,0,6,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ConfigRow}">
                                            <Grid>
                                                <Button x:Name="RowBtn" Style="{StaticResource RowButton}" ToolTip="{Binding Description}"
                                                        Command="{Binding DataContext.Settings.EditRowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="k" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Key}" />
                                                        <TextBlock Grid.Column="1" Style="{StaticResource Dim}" Margin="4,0" ClipToBounds="True" TextTrimming="None"
                                                                   Text=" ......................................................................................................" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Display}" Foreground="{StaticResource FgBright}" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3" Text="  PENDING RESTART" Foreground="{StaticResource FgBright}" Visibility="{Binding Pending, Converter={StaticResource Vis}}" />
                                                    </Grid>
                                                </Button>
                                                <DockPanel Background="{StaticResource Bg}" Visibility="{Binding IsEditing, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="{Binding Key}" />
                                                    <TextBlock Text=" = " Style="{StaticResource Dim}" />
                                                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                             PreviewKeyDown="RowEditor_PreviewKeyDown" IsVisibleChanged="RowEditor_IsVisibleChanged" c:BlockCaret.Enabled="True" />
                                                </DockPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- ============ FILES -->
                        <Grid Grid.Row="2" Visibility="{Binding TabIndex, Converter={StaticResource TabVis}, ConverterParameter=5}" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding NewFileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="new knowledge file name" />
                                    <WrapPanel>
                                        <Button Content="NEW" Command="{Binding NewFileCommand}" Margin="0,2,6,0" ToolTip="Create a knowledge file with the name typed above" />
                                        <Button Content="DEL" Command="{Binding DeleteFileCommand}" Margin="0,2,0,0" ToolTip="Delete the selected knowledge file (asks first)" />
                                    </WrapPanel>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                <Run Text="{Binding Area, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding Name, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource FgDim}" HorizontalAlignment="Center" />
                            <DockPanel Grid.Column="2">
                                <DockPanel DockPanel.Dock="Top">
                                    <Button DockPanel.Dock="Right" Content="SAVE ^S" Command="{Binding SaveFileCommand}" ToolTip="Save to the server (Ctrl+S); knowledge is re-indexed in seconds" />
                                    <TextBlock Text="{Binding SelectedFile.Name}" Foreground="{StaticResource FgBright}" />
                                    <TextBlock Text=" *" Foreground="{StaticResource FgBright}" Visibility="{Binding Dirty, Converter={StaticResource Vis}}" />
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer x:Name="LineNumberScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <TextBlock x:Name="LineNumbers" Style="{StaticResource Dim}" TextAlignment="Right" Margin="0,0,6,0" Text="1" />
                                    </ScrollViewer>
                                    <TextBox x:Name="Editor" Grid.Column="1" Style="{StaticResource EditorBox}"
                                             Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="Editor_TextChanged" ScrollViewer.ScrollChanged="Editor_ScrollChanged">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveFileCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>
                            </DockPanel>
                        </Grid>

                        <!-- ============ STATUS -->
                        <DockPanel Grid.Row="2" Visibility="{Binding TabIndex, Converter={StaticResource TabVis}, ConverterParameter=6}" Margin="0,4,0,0">
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" Content="RESTART SERVER" Command="{Binding RestartServerCommand}" ToolTip="Restart the TARS server process (asks first)" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding StatusSummary}" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Head}" Text="LOG · live tail, 2 s" />
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding LogLines}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Dim}" TextWrapping="Wrap" FontSize="15" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- message line -->
                        <DockPanel Grid.Row="3" Margin="0,2,0,0">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Dim}" Text="^←/^→ TABS · ↑/↓ MOVE · ESC CLOSE" />
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource FgBright}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Grid>

                    <!-- ~~~ timers -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Timers}" ItemTemplate="{StaticResource TimerTemplate}"
                                  Visibility="{Binding HasTimers, Converter={StaticResource Vis}}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- ~~~ footer -->
                    <DockPanel Grid.Row="3" Margin="0,1,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="SET" Click="Settings_Click" Focusable="False" ToolTip="Settings: voice, audio, system, server (F2)" />
                            <Button Content="{Binding ModeLabel}" Command="{Binding CycleModeCommand}" Focusable="False"
                                    ToolTip="Listening mode. Click to cycle: PTT (hold a key) → WAKE (say &quot;TARS&quot;) → OPEN (always listening)" />
                            <Button x:Name="PttButton" Content="PTT" Focusable="False" ToolTip="Hold to talk (or hold Right Ctrl anywhere / Space in this window)"
                                    PreviewMouseLeftButtonDown="Ptt_Down" PreviewMouseLeftButtonUp="Ptt_Up" LostMouseCapture="Ptt_Lost" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal" Background="Transparent" MouseLeftButtonUp="Mic_Click"
                                        ToolTip="Microphone level (click to unmute if Windows has it muted)">
                                <TextBlock Text="MIC " Style="{StaticResource Dim}" />
                                <c:CellMeter Cells="8" Level="{Binding MicLevel}" Margin="0,0,10,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Background="Transparent" MouseWheel="Volume_MouseWheel" ToolTip="TARS volume: scroll to change (0–150 %)">
                                <TextBlock Text="VOL " Style="{StaticResource Dim}" />
                                <c:CellMeter Cells="9" Level="{Binding VolumeLevel}" Hot="{Binding VolumeHot}" />
                                <TextBlock Text="{Binding VolumeText}" Margin="4,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- ======================================================== confirm overlay -->
            <Grid Background="#CC000000" Visibility="{Binding Settings.ConfirmVisible, Converter={StaticResource Vis}}">
                <Border BorderBrush="{StaticResource FgBright}" BorderThickness="1" Background="{StaticResource Bg}" Padding="10,8"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="12">
                    <StackPanel>
                        <TextBlock Text="▲ CONFIRM" Foreground="{StaticResource FgBright}" />
                        <TextBlock Text="{Binding Settings.ConfirmText}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ConfirmYes" Content="CONFIRM" Command="{Binding Settings.ConfirmYesCommand}" Margin="0,0,8,0" ToolTip="Go ahead" />
                            <Button Content="CANCEL" Command="{Binding Settings.ConfirmNoCommand}" IsCancel="True" ToolTip="Back out (Esc)" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================================================== CRT scanlines -->
            <Rectangle Fill="{StaticResource ScanlineBrush}" IsHitTestVisible="False"
                       Visibility="{Binding Scanlines, Converter={StaticResource Vis}}" />
        </Grid>
    </Border>
</Window>
