<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>TARS-Setup</AssemblyName>
    <RootNamespace>TarsSetup</RootNamespace>
    <ApplicationIcon>..\TarsClient\Assets\tars.ico</ApplicationIcon>
    <Product>TARS Desktop Setup</Product>
    <!-- build/build-installer.ps1 passes the published client as a zip -->
    <PayloadZip Condition="'$(PayloadZip)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\payload.zip</PayloadZip>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\TarsClient\Assets\VT323-Regular.ttf" Link="Assets\VT323-Regular.ttf" />
    <Resource Include="..\TarsClient\Assets\tars.ico" Link="Assets\tars.ico" />
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" Condition="Exists('$(PayloadZip)')" />
  </ItemGroup>

</Project>
