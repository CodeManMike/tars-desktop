<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- With warnings as errors, this makes "XML docs on every public member" a build rule (CS1591). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CommunityToolkit.Mvvm 8.4 only generates [ObservableProperty] partial properties under the preview language version. -->
    <LangVersion>preview</LangVersion>
    <Version>1.0.0</Version>
    <Company>Michael</Company>
  </PropertyGroup>
</Project>
